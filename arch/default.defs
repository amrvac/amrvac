F90=mpif90
FFLAGS = -c
# -fallow-argument-mismatch: silence gfortran 10+ checks on MPI
# choice-buffer arguments. Add it only when the active mpif90 wrapper accepts
# it, since gfortran 9 and non-GNU compilers reject the option.
FALLOW_ARGUMENT_MISMATCH := $(shell tmp=$$(mktemp /tmp/amrvac_fallow_argument_mismatch.XXXXXX); src=$$tmp.f90; printf 'end\n' > $$src; if $(F90) -fallow-argument-mismatch -c $$src -o $$tmp.o >/dev/null 2>&1; then printf '%s' '-fallow-argument-mismatch'; fi; rm -f $$src $$tmp.o)
FPE_SUMMARY_OPTION := $(shell tmp=$$(mktemp /tmp/amrvac_ffpe_summary.XXXXXX); src=$$tmp.f90; printf 'end\n' > $$src; if $(F90) -ffpe-summary=invalid,zero,overflow -c $$src -o $$tmp.o >/dev/null 2>&1; then printf '%s' '-ffpe-summary=invalid,zero,overflow'; fi; rm -f $$src $$tmp.o)
F90FLAGS = -cpp -ffree-form -fimplicit-none -O3 -Wall -Wno-unused-dummy-argument	\
-Wno-unused-function -Wno-unused -Wno-uninitialized -Wno-zerotrip -Wno-target-lifetime \
$(FALLOW_ARGUMENT_MISMATCH) $(FPE_SUMMARY_OPTION)
LINK= $(F90)  $(F90FLAGS)
