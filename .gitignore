# Generated documentation
doc/html/*
doc/ford/html/
doc/ford/src/

# Build products. Each case directory gets its own build/ cache, an `agile`
# executable and a config.mk generated from agile.par by make/config_reader.py.
**/build/
agile
config.mk
*.mod
*.o
*.f90
/tools/fortran/compare_logs

# Simulation output. correct_output/ holds the reference logs the tests diff
# against, so it has to survive the *.log rule above it.
*.dat
*.vtu
*.vti
*.out
*.log
*.log.shfp.*
# the rho convergence study's runs (tests/rho/convergence/run_convergence.sh)
tests/rho/output/
!**/correct_output/**

# Editors, Python, misc
*.bak
*~
*\#
*__pycache__/
*.pyc
.idea/
.*.swp
*.npy

