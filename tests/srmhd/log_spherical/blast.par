 &usr_list
   ! Which initial condition this run uses; see mod_usr.fpp.
   ! Everything else about the build is shared with the other par
   ! files in this directory.
   setup = 'blast'
 /

 &filelist
   base_filename    = 'blast'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.025d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'srmhd'
 /

 &boundlist
   typeboundary_min1 = 8*'cont'
   typeboundary_max1 = 8*'cont'
   typeboundary_min2 = 8*'cont'
   typeboundary_max2 = 8*'cont'
   typeboundary_min3 = 8*'cont'
   typeboundary_max3 = 8*'cont'
 /

 &meshlist
   ! NOTE: the radial bounds are physical radii; read_par_files
   ! stores them as ln(r) because geometry is 'logSpherical'.
   ! NOTE: angular coordinates (theta, phi here) are given in units of 2*pi,
   ! so theta runs over [pi/4, 3pi/4] and phi over [0, pi/2] below. The domain
   ! deliberately stays away from the polar axis and from r = 0.
   geometry           = 'logSpherical'
   max_blocks         =  128
   refine_max_level   =  1
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  32
   domain_nx2         =  32
   domain_nx3         =  32
   xprobmin1          =  1.0d0
   xprobmax1          =  4.0d0
   xprobmin2          =  0.125d0
   xprobmax2          =  0.375d0
   xprobmin3          =  0.0d0
   xprobmax3          =  0.25d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

 &srmhd_list
   srmhd_gamma       = 1.666667d0
   srmhd_eos        = .false.
   He_abundance     = 0.0d0
 /
