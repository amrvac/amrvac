 &filelist
   base_filename    = 'uflow'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.1d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'srmhd'
 /

 &boundlist
   ! The r boundaries are ordinary open boundaries held at the exact solution.
   ! The axis faces are 'pole': read_par_files turns that into per-variable
   ! symm/asymm entries, and getbc fills those ghost cells from the block half
   ! a revolution away in phi rather than from a boundary condition. That only
   ! works if phi itself is periodic over a full turn, hence 'periodic' below.
   typeboundary_min1 = 8*'special'
   typeboundary_max1 = 8*'special'
   typeboundary_min2 = 8*'pole'
   typeboundary_max2 = 8*'pole'
   typeboundary_min3 = 8*'periodic'
   typeboundary_max3 = 8*'periodic'
   specialboundary   = .true.
 /

 &meshlist
   ! NOTE: angular coordinates are given in units of 2*pi, so theta runs over
   ! the full [0, pi] and phi over the full [0, 2*pi]. Unlike the other
   ! spherical cases this domain deliberately runs onto the polar axis at both
   ! ends. The number of level-1 blocks across phi (domain_nx3/block_nx3 = 2)
   ! has to be even, because the block on the far side of a pole is found by
   ! shifting the phi block index by half of it.
   geometry           = 'spherical'
   max_blocks         =  128
   refine_max_level   =  1
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  0.5d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

 &srmhd_list
   srmhd_gamma       = 1.666667d0
   srmhd_eos        = .false.
   He_abundance     = 0.0d0
 /
