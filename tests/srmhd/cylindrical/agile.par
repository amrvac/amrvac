! agile.par is what the build reads. make/config_reader.py takes the
! compile-time parameters from *this* file alone, so it has to declare the
! union of what every par file in this directory needs: geometry, phys and
! specialboundary. blast.par leaves specialboundary out - it is a runtime
! logical as well as a fypp define - but specialbound_usr has to be compiled
! in either way. See test.make.

 &usr_list
   setup = 'uniform'
 /


 &filelist
   base_filename    = 'uflow'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.1d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'srmhd'
 /

 &boundlist
   typeboundary_min1 = 8*'special'
   typeboundary_max1 = 8*'special'
   typeboundary_min2 = 8*'special'
   typeboundary_max2 = 8*'special'
   typeboundary_min3 = 8*'special'
   typeboundary_max3 = 8*'special'
   specialboundary   = .true.
 /

 &meshlist
   ! NOTE: phi (dim3) is given in units of 2*pi, so it runs over [0, pi/2]
   ! below; z (dim2) is a plain length. The domain deliberately stays away
   ! from the cylindrical axis r = 0.
   geometry           = 'cylindrical'
   max_blocks         =  128
   refine_max_level   =  1
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  1.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  0.25d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

 &srmhd_list
   srmhd_gamma       = 1.666667d0
   srmhd_eos        = .false.
   He_abundance     = 0.0d0
 /
