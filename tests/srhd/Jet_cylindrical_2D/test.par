! SRHD jet setup, cylindrical version, follows Seo et al ApJ 2021, 920:144
! setup.pl -d=2 -v=2

 &filelist
        base_filename='SRHD_Jet'  ! Base file name for dat/vtu output
        typefilelog='regression_test'
        autoconvert=F
/

 &savelist
        dtsave_log=0.1d0        ! For the log
        dtsave_dat=1.0d0         ! For dat/vtu output
 /

 &stoplist
        time_max=0.5d0
        dtmin=1.0d-9
 /

 &methodlist
        time_stepper=  'fourstep'
        flux_scheme=20*'hll'
        limiter=20*'woodward'
        small_density=1.0d-13
        small_pressure=1.0d-12
        check_small_values=.false.
        fix_small_values=.true.
        small_values_method='average'
 /

 &boundlist
        typeboundary_min1 = 'symm','asymm','symm','symm'
        typeboundary_max1 = 4*'cont'
        typeboundary_min2 = 4*'special'
        typeboundary_max2 = 4*'cont'
 /

 &meshlist
        refine_max_level=3
        w_refine_weight(1)=0.5d0
        w_refine_weight(3)=0.5d0
        domain_nx1=120
        domain_nx2=360
        block_nx1=10
        block_nx2=10
        xprobmin1=0.0d0
        xprobmax1=20.0d0
        xprobmin2=0.0d0
        xprobmax2=60.0d0
 /

 &paramlist
        typecourant='maxsum'
        courantpar=0.4d0
        slowsteps=1000
 /

 &srhd_list
        srhd_n_tracer=1
        srhd_eos=.true.
        srhd_gamma=1.66667d0
        SI_unit=.false.
        He_abundance=0.1d0
 /

 &usr_list
        rjet= 1.0d0
        zjet= 0.25d0
        rhob=1.0d0
        etarho=1.0d-5
        pb=7.64d-6
        zetap=1.0d0
        lfacjet=20.0d0
 /
