 &filelist
   typefilelog      = 'regression_test'
   base_filename    = 'test-fixgrid'
 /

 &savelist
   itsave(1,1)      = 0
   dtsave_log       = 0.05d0
   dtsave_dat       = 1.0d10
 /

 &stoplist
   time_max         = 0.1d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'tvdlf'
   limiter         = 20*'vanleer'
   phys            = 'rho'
 /

 &boundlist
   typeboundary_min1 = 'periodic'
   typeboundary_max1 = 'periodic'
   typeboundary_min2 = 'periodic'
   typeboundary_max2 = 'periodic'
   typeboundary_min3 = 'periodic'
   typeboundary_max3 = 'periodic'
 /

 &meshlist
   max_blocks         = 1024
   refine_max_level   = 2
   refine_criterion   = 3 ! Lohner criterion
   refine_usr         = .false.
   itfixgrid          = 0
   block_nx1          = 8
   block_nx2          = 8
   block_nx3          = 8
   domain_nx1         = 32
   domain_nx2         = 32
   domain_nx3         = 32
   xprobmin1          = -0.5d0
   xprobmax1          =  0.5d0
   xprobmin2          = -0.5d0
   xprobmax2          =  0.5d0
   xprobmin3          = -0.5d0
   xprobmax3          =  0.5d0
 /

 &paramlist
   courantpar       = 0.7d0
   typecourant      = 'maxsum'
 /

 &rho_list
   rho_v = 1.0d0, 1.0d0, 1.0d0
 /

 &usr_list
   setup = 'ball'
 /
