 &filelist
   base_filename='short'
   saveprim=.true.
   convert=.false.
 /
 &savelist
   ditsave_log=1
   itsave(1,1)=0
   itsave(1,2)=0
   dtsave_dat=1.d99
 /
 &stoplist
   dtmin=1.d-12
   time_max=1.d-6
 /
 &meshlist
   domain_nx1=16
   domain_nx2=16
   block_nx1=8
   block_nx2=8
   refine_max_level=1
 /
 &usr_list
   kink_amplitude=1.d-4
 /
