 &filelist
        base_filename = 'ambi'
        typefilelog='regression_test'
 /
        autoconvert   = T
        saveprim      = T
        nwauxio       = 1

 &savelist
        dtsave_log=1d-4
        dtsave_dat=1d-1
 /

 &stoplist
        time_max      = 1d-3
 /

 &methodlist
        time_stepper = 'threestep'
        flux_scheme     = 20*'hll'
        limiter  = 20*'cada3'
        small_values_method = 'ignore'
 /

 &boundlist
        typeboundary_min1  = 8*'special'
        typeboundary_max1  = 'special',3*'symm','special',3*'symm'
 /

 &meshlist
        refine_max_level = 1
        domain_nx1    = 3200
        block_nx1     = 50
        xprobmin1     = 0.5d0
        xprobmax1     = 2.1d0
 /

 &paramlist
        courantpar    = 0.8d0
 /

 &mhd_list
        B0field=.true.
        B0field_forcefree=.true.
        mhd_gravity   =  .true.
        SI_unit       =  .true.
        mhd_ambipolar =  .true.
        mhd_eta_ambi  = 1.0d-3
        mhd_ambipolar_sts = .true.
 /

 &sts_list
        sts_ncycles=1000
        sts_method=1
        sourcetype_sts=2
 /

 &usr_list
        Period= 5.0d0
        ampl=1.0d-3
        maskAmbi = .true.
        xLambi = 1.65d0
        ambi_mask_method = 1
        ambi_mask_smooth = .true.
/
 &eos_list
  He_abundance = 0d0
 /

