&filelist
        base_filename='advect_alfven_test'
        typefilelog='regression_test'
        autoconvert=F
 /

 &savelist
        itsave(1,1)=0
        itsave(1,2)=0
        dtsave_log=0.05d0
        dtsave_dat=0.5d0
 /

 &stoplist
        time_max=0.5d0
 /

 &methodlist
        time_stepper=  'threestep'
        flux_scheme =  20*'tvdlf'
        limiter     =  20*'koren'
 /

 &boundlist
        typeboundary_min1='cont'
        typeboundary_max1='cont'
        typeboundary_min2='cont'
        typeboundary_max2='bc_data'
 /

 &meshlist
        refine_max_level=4
        refine_criterion=1
        domain_nx1=64
        domain_nx2=128
        xprobmin1=0.0d0
        xprobmax1=1.0d0
        xprobmin2=0.0d0
        xprobmax2=1.5d0
 /

 &paramlist
       courantpar=0.8d0
 /

 &rho_list
        rho_v = 0.0,-1.0
 /

 &bd_list
       boundary_data_file_name='alfven.vtk'
 /
