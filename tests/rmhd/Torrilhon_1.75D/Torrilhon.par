&filelist
  base_filename='output/Torrilhon_diff_nomg'
  autoconvert      = F
/
  typefilelog='regression_test'

 &savelist
   itsave(1,1)=0
   itsave(1,2)=0
   ditsave_log     = 10
   dtsave_dat     = 0.01d0
/

 &stoplist
   time_max = 0.4d0
/

 &methodlist
        time_stepper = 'threestep'    
        time_integrator = 'IMEX_ARS3'
        flux_scheme=    20*'hll'
        limiter= 20*'weno3'
 /

 &boundlist
        typeboundary_min1=9*'cont' 
        typeboundary_max1=9*'cont' 
 /

 &meshlist
        refine_criterion=3
        refine_max_level= 7
        w_refine_weight(1)=0.5
        w_refine_weight(3)=0.5
        refine_threshold=20*0.05d0
        domain_nx1=1024
        block_nx1 = 16
        xprobmin1=-1.d0
        xprobmax1= 1.d0
 /

 &paramlist
        courantpar=0.8d0
        slowsteps=20000
 /

 &mhd_list
     typedivbfix='none'
     mhd_energy = .true.
     mhd_radiation_fld = .true.
 /

 &eos_list
  gamma = 1.6666667d0
  He_abundance = 0.0d0
 /

 &fld_list
     fld_Radforce_split = .false.
     fld_opacity_law = 'const'
     fld_kappa0 = 4000.0d0
     fld_interaction_method = 'Halley'
     fld_fluxlimiter = 'Diffusion'
     fld_diff_tol = 1.d-7
     fld_bisect_tol=1.d-6
     fld_tiring_explicit=.true.
     fld_no_mg=.true.
 /
