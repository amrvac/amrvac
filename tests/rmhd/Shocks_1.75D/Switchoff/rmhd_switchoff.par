
&filelist
  base_filename='output/rmhd_switchoff_full'
  autoconvert      = F
  typefilelog = 'regression_test'
  nwauxio=2 
/

&savelist
   itsave(1,1)     = 0
   itsave(1,2)     = 0
   dtsave_dat     = 1.d0
   dtsave_log     = 1.d0
/

&stoplist
   time_max = 1.0d0
   dtmin = 1.0d-20
/

 &methodlist
   time_stepper    = 'threestep'
   time_integrator = 'IMEX_ARS3'
   flux_scheme     = 20*'hll'
   limiter         = 20*'weno3'
/

&boundlist
  typeboundary_min1 = 9*'special' 
  typeboundary_max1 = 9*'special' 
/

 &meshlist
   refine_max_level   = 5
   refine_criterion   = 3
   domain_nx1         = 256
   block_nx1          = 16
   xprobmin1       = -5.d0
   xprobmax1       = 5.d0
   refine_threshold   = 20*0.5d0
   derefine_ratio     = 20*1.d0/2.d0
 /

 &paramlist
  courantpar       = 0.6d0
  slowsteps = 2000
 /

 &mhd_list
  mhd_energy = .true.
  mhd_radiation_fld = .true.
 /

&eos_list
  He_abundance = 0.d0 
  gamma = 1.4d0
/

 &fld_list
  fld_Radforce_split = .false.
  fld_opacity_law = 'const'
  fld_kappa0 = 0.4d0
  fld_interaction_method = 'Halley'
  fld_fluxlimiter = 'Diffusion'
  fld_diff_tol = 1.d-7
  fld_tiring_explicit=.true.
  /

  &shock_list
   rho1 = 0.00796933
   rho2 = 0.03038109342
   T1 = 6141.3520579266
   vx1 = 3.9868219867588d7
   vy1 = 3.22643d6 
   vz1 = 4.95596d6 
   Bx1 = 12616610.096153 
   By1 = 46424572.074395
   Bz1 = -7737434.5872453 
   /
