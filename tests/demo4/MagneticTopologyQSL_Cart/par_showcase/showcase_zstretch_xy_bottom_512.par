! Z-stretched AMR l3 bottom xy plane, 512x512 seeds.
&filelist
  convert=.true.
  convert_type='user'
  autoconvert=.false.
  restart_from_file='output/qsl_tdm_amr_l3_zstretch_0000.dat'
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&meshlist
  refine_max_level=3
  refine_criterion=1
  max_blocks=12000
  block_nx1=32
  block_nx2=32
  block_nx3=32
  domain_nx1=128
  domain_nx2=96
  domain_nx3=128
  xprobmin1=-10.d0
  xprobmax1= 10.d0
  xprobmin2=-7.5d0
  xprobmax2= 7.5d0
  xprobmin3= 0.d0
  xprobmax3= 10.d0
  stretch_dim(3)='uni'
  qstretch_baselevel(3)=1.02d0
/

&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'axis_plane_full_vtu'
  mt_vtk_detail = 'minimal'
  mt_output_file = 'output/showcase/zstretch_xy_bottom_512.vti'
  mt_step_control = 'cell_fraction'
  mt_step_fraction = 4.0d0
  mt_trace_integrator = 'rk45_cartesian'
  mt_rk45_atol = 1.d-8
  mt_rk45_rtol = 1.d-4
  mt_rk45_tangent_rtol = 1.d-3
  mt_max_steps = -1
  mt_b_min = 1.d-8
  mt_compute_twist = .true.
  mt_compute_q = .true.
  mt_compute_qperp = .true.
  mt_plane = 'xy'
  mt_xmin = -9.d0
  mt_xmax =  9.d0
  mt_nx = 512
  mt_ymin = -7.d0
  mt_ymax =  7.d0
  mt_ny = 512
  mt_z0 = 0.05d0
/
