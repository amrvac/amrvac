! Initialize the TDm/RBSL-like demo field on an AMR mesh.
! Base grid: 128 x 96 x 128. Max refinement level: 3. Maximum local effective
! resolution is about uniform 512 x 384 x 512 under the current AMRVAC convention.
! This writes a snapshot only; it does not run magnetic topology tracing.

&filelist
  base_filename='output/qsl_tdm_amr_l3_'
  saveprim=.true.
  autoconvert=.false.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&meshlist
  refine_max_level=3
  refine_criterion=1
  max_blocks=12000
  block_nx1=32
  block_nx2=32
  block_nx3=32
  domain_nx1=128
  domain_nx2=96
  domain_nx3=128
  xprobmin1=-10.d0
  xprobmax1= 10.d0
  xprobmin2=-7.5d0
  xprobmax2= 7.5d0
  xprobmin3= 0.d0
  xprobmax3= 10.d0
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&usr_list
  minor_radius_cm=2.25d9
  n_axis_points=400
  rho0=1.0d0
  pressure0=1.0d0
/

&magnetic_topology_list
/
