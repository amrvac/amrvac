! Generate a light TDm/RBSL snapshot for the finite-volume helicity demo.
! The output is output/tdm_0000.dat.

&filelist
  base_filename='output/tdm_'
  saveprim=.true.
  autoconvert=.false.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&meshlist
  refine_max_level=1
  block_nx1=16
  block_nx2=16
  block_nx3=16
  domain_nx1=64
  domain_nx2=48
  domain_nx3=64
  xprobmin1=-10.d0
  xprobmax1= 10.d0
  xprobmin2=-7.5d0
  xprobmax2= 7.5d0
  xprobmin3= 0.d0
  xprobmax3= 10.d0
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&usr_list
  minor_radius_cm=2.25d9
  n_axis_points=256
  rho0=1.0d0
  pressure0=1.0d0
/
