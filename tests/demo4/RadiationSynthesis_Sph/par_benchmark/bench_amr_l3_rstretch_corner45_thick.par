! Parallel-scaling benchmark: spherical radially stretched AMR base 128x96x128
! level-3 snapshot. Data-resolution, optically thick AIA 171 image from a
! cube-corner LOS. Run after par_init/amr_l3_rstretch.par.

&filelist
  convert=.true.
  firstprocess=.false.
  autoconvert=.false.
  convert_type='EIvtiCCmpi'
  restart_from_file='output/radsyn_sph_prom_amr_l3_rstretch_0000.dat'
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&meshlist
  refine_max_level=3
  refine_criterion=1
  max_blocks=12000
  block_nx1=32
  block_nx2=32
  block_nx3=32
  domain_nx1=128
  domain_nx2=96
  domain_nx3=128
  xprobmin1=69.61d0
  xprobmax1=79.61d0
  xprobmin2=0.2270568141714314d0
  xprobmax2=0.2729431858285686d0
  xprobmin3=-0.01718120494117723d0
  xprobmax3= 0.01718120494117723d0
  stretch_dim(1)='uni'
  stretch_uncentered=.false.
  qstretch_baselevel(1)=1.02d0
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&emissionlist
  filename_euv='output/benchmark/AIA171_spherical_corner45_thick_amr_l3_rstretch_'
  wavelength=171
  LOS_theta=54.735610317245346d0
  LOS_phi=45.d0
  dat_resolution=.true.
  radiation_transfer='thick'
  ray_method='sph_dda'
  emission_model='euv_aia'
  output_tau=.true.
  output_absorption_fraction=.true.
/
