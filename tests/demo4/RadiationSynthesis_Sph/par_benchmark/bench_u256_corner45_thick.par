! Parallel-scaling benchmark: spherical uniform 256x192x256 snapshot.
! Data-resolution, optically thick AIA 171 image from a cube-corner LOS.
! Run after par_init/u256.par.

&filelist
  convert=.true.
  firstprocess=.false.
  autoconvert=.false.
  convert_type='EIvtiCCmpi'
  restart_from_file='output/radsyn_sph_prom_u256_0000.dat'
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&meshlist
  refine_max_level=1
  refine_criterion=3
  max_blocks=2000
  block_nx1=32
  block_nx2=32
  block_nx3=32
  domain_nx1=256
  domain_nx2=192
  domain_nx3=256
  xprobmin1=69.61d0
  xprobmax1=79.61d0
  xprobmin2=0.2270568141714314d0
  xprobmax2=0.2729431858285686d0
  xprobmin3=-0.01718120494117723d0
  xprobmax3= 0.01718120494117723d0
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&emissionlist
  filename_euv='output/benchmark/AIA171_spherical_corner45_thick_u256_'
  wavelength=171
  LOS_theta=54.735610317245346d0
  LOS_phi=45.d0
  dat_resolution=.true.
  radiation_transfer='thick'
  ray_method='spherical'
  emission_model='euv_aia'
  output_tau=.true.
  output_absorption_fraction=.true.
/
