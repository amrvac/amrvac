! setup.pl -d=2 -v=3
&filelist
  base_filename=''
  autoconvert=.true.
  convert_type='vtuBCCmpi'
  saveprim=.true.
  nwauxio=10
  typefilelog='special'
/
&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_log=5.d-3
  dtsave_dat=5.d-2
/
&stoplist
  time_max=1.d0
/
&methodlist
  time_stepper='threestep'
  flux_scheme=20*'hll'
  limiter=20*'vanleer'
  typeboundspeed='cmaxmean'
  small_pressure=1.d-14
  small_density=1.d-14
  fix_small_values=.true.
  small_values_method='average'
/
&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'special'
  typeboundary_max2=8*'special'
/
&meshlist
  refine_criterion=3
  refine_max_level=3
  block_nx1=16
  block_nx2=16
  domain_nx1=128
  domain_nx2=128
  w_refine_weight(1)=0.2d0
  w_refine_weight(7)=0.4d0
  w_refine_weight(9)=0.4d0
  xprobmin1=-10.d0
  xprobmax1=10.d0
  xprobmin2=0.d0
  xprobmax2=20.d0
  prolongprimitive=.true.
/
&paramlist
  typecourant='maxsum'
  courantpar=0.6d0
/
&eos_list
  eos_type='FI'
  He_abundance=0.d0
/
&mhd_list
  mhd_thermal_conduction=.false.
  mhd_hyperbolic_tc=.true.
  mhd_hyperbolic_tc_kappa=0.d0
  mhd_hyperbolic_tc_sat=.true.
  mhd_hyperbolic_tc_use_perp=.false.
  mhd_hyperbolic_tc_perp_mode='off'
  mhd_hyperbolic_tc_coulomb_log=20.d0
  mhd_radiative_cooling=.false.
  mhd_gravity=.false.
  mhd_energy=.true.
  mhd_internal_e=.true.
  typedivbfix='ct'
  boundary_divbfix(3)=.false.
  B0field=.true.
  B0field_forcefree=.true.
  Busr=40.d0
  mhd_eta=-0.1d0
/
&usr_list
  sheet_ymin=5.d0
  sheet_ymax=12.d0
  sheet_core_halfwidth=0.4d0
  sheet_halo_halfwidth=2.d0
  evaporation_height=0.5d0
  reconnection_xmax=0.6d0
  reconnection_ymin=4.d0
  reconnection_ymax=10.d0
  eta_fixed_amplitude=2.d-4
/
