!$AMRVAC_DIR/setup.pl -d=3

&filelist
  ! Kept empty so an optional workflow override can supply its own prefix.
  ! The standalone benchmark assigns 'grad_rubin_td99' in mod_usr.t.
  base_filename=''
  saveprim=.true.
  autoconvert=.false.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
/

&boundlist
  typeboundary_min1=7*'cont'
  typeboundary_max1=7*'cont'
  typeboundary_min2=7*'cont'
  typeboundary_max2=7*'cont'
  typeboundary_min3=7*'cont'
  typeboundary_max3=7*'cont'
/

&meshlist
  refine_max_level=1
  block_nx1=128
  block_nx2=128
  block_nx3=24
  domain_nx1=128
  domain_nx2=128
  domain_nx3=24
  xprobmin1=-12.09448818897637795d0
  xprobmax1= 12.09448818897637795d0
  xprobmin2=-12.09448818897637795d0
  xprobmax2= 12.09448818897637795d0
  xprobmin3= 0.09448818897637795d0
  xprobmax3= 4.62992125984251969d0
/

&mhd_list
  mhd_energy=.false.
  typedivbfix='none'
  B0field=.false.
/

&usr_list
  run_mode='grad_rubin'
  boundary_filename='td99_boundary_v1.dat'
  gr_alpha_source='external'
  gr_alpha_filename='td99_external_alpha_v1.dat'
  gr_fft_padding_factor=1
  gr_flux_treatment='strict'
  gr_max_flux_imbalance=0.1d0
  gr_polarity=-1
  gr_bz_taper_zero=0.01d0
  gr_bz_taper_full=0.02d0
  gr_relaxation_factor=0.5d0
  gr_fieldline_step_fraction=0.5d0
  gr_fieldline_max_steps=10000
  gr_max_iterations=16
  gr_convergence_streak=3
  gr_field_change_tolerance=0.d0
  gr_energy_change_tolerance=0.d0
  gr_log_interval=1
  gr_memory_limit_mb=2048.d0
  gr_write_detailed_history=.true.
/
