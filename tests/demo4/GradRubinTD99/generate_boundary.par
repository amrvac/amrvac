!$AMRVAC_DIR/setup.pl -d=3

&filelist
  base_filename=''
  saveprim=.true.
  autoconvert=.false.
/

&stoplist
  it_max=0
/

&boundlist
  typeboundary_min1=7*'cont'
  typeboundary_max1=7*'cont'
  typeboundary_min2=7*'cont'
  typeboundary_max2=7*'cont'
  typeboundary_min3=7*'cont'
  typeboundary_max3=7*'cont'
/

&meshlist
  refine_max_level=1
  block_nx1=128
  block_nx2=128
  block_nx3=4
  domain_nx1=128
  domain_nx2=128
  domain_nx3=4
  xprobmin1=-12.09448818897637795d0
  xprobmax1= 12.09448818897637795d0
  xprobmin2=-12.09448818897637795d0
  xprobmax2= 12.09448818897637795d0
  xprobmin3= 0.09448818897637795d0
  xprobmax3= 0.85039370078740155d0
/

&mhd_list
  mhd_energy=.false.
  typedivbfix='none'
  B0field=.false.
/

&usr_list
  run_mode='generate_boundary'
  boundary_export_filename='td99_boundary_v1.dat'
  alpha_export_filename='td99_external_alpha_v1.dat'
  i0_effective_ta=13.d0
  alpha_step_scale=0.25d0
/
