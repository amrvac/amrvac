!$AMRVAC_DIR/setup.pl -d=3

&filelist
  base_filename='td99_optimization'
  saveprim=.true.
  autoconvert=.false.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
/

&boundlist
  typeboundary_min1=3*'cont'
  typeboundary_max1=3*'cont'
  typeboundary_min2=3*'cont'
  typeboundary_max2=3*'cont'
  typeboundary_min3=3*'cont'
  typeboundary_max3=3*'cont'
/

&meshlist
  refine_max_level=1
  block_nx1=50
  block_nx2=50
  block_nx3=4
  domain_nx1=500
  domain_nx2=500
  domain_nx3=88
  xprobmin1=-60.12024048096192d0
  xprobmax1= 60.12024048096192d0
  xprobmin2=-60.12024048096192d0
  xprobmax2= 60.12024048096192d0
  xprobmin3= 0.12024048096192385d0
  xprobmax3=21.28256513026052d0
/

&usr_list
  run_mode='optimization'
  boundary_filename='td99_boundary_v1.dat'
  fft_padding_factor=2
  fft_top_boundary='open'
  lfff_flux_treatment='strict'
  lfff_max_flux_imbalance=0.1d0
  nlfff_buffer_cells=10
  nlfff_max_iterations=1000
  nlfff_initial_step_scale=0.1d0
  nlfff_log_interval=1
  nlfff_update_preconditioner='binomial_xy'
  nlfff_write_detailed_history=.true.
  nlfff_plateau_enabled=.true.
  nlfff_plateau_interval=10
  nlfff_plateau_window=10
  nlfff_plateau_tolerance=1.d-4
/
