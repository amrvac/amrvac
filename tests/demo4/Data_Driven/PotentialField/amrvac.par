!$AMRVAC_DIR/setup.pl -d=3

&filelist
  base_filename='output/data_driven_potential'
  saveprim=.true.
  autoconvert=.true.
  convert_type='vtuBmpi'
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
/

&boundlist
  ! mhd_energy=.false.: rho + 3 momentum + 3 magnetic variables need BCs.
  typeboundary_min1=7*'cont'
  typeboundary_max1=7*'cont'
  typeboundary_min2=7*'cont'
  typeboundary_max2=7*'cont'
  typeboundary_min3=7*'cont'
  typeboundary_max3=7*'cont'
/

&meshlist
  refine_max_level=1
  block_nx1=12
  block_nx2=12
  block_nx3=12
  domain_nx1=144
  domain_nx2=96
  domain_nx3=96
  xprobmin1=-11.13894d0
  xprobmax1=11.13894d0
  xprobmin2=-7.474815d0
  xprobmax2=7.474815d0
  ! The magnetogram is at z=0 on the adjacent lower ghost-cell center.
  xprobmin3=0.07786265625d0
  xprobmax3=15.02749265625d0
/

&mhd_list
  mhd_energy=.false.
  ! The extrapolated field is constructed directly and is not time advanced.
  ! Avoid an unnecessary GLM psi variable in the restart snapshot.
  typedivbfix='none'
/

&usr_list
  boundary_filename='boundary_single/B_0001.dat'
  lalpha=0.d0
  ! Green source depth for a z=0 first-ghost-center magnetogram.
  ! FFT requires llift=0.
  llift=0.d0
  ! 'fft' is the default; 'green' keeps the legacy Green-function behavior.
  ! FFT requires llift=0,
  ! refine_max_level=1, a uniform Cartesian grid, and stagger_grid=.false.
  potential_field_method='fft'
  fft_padding_factor=2
  fft_top_boundary='open'
  ! Nonzero-alpha LFFF only: automatic mean subtraction is opt-in and is
  ! refused when the input relative flux imbalance exceeds this threshold.
  lfff_flux_treatment='strict'
  lfff_max_flux_imbalance=0.1d0
/
