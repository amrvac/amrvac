!$AMRVAC_DIR/setup.pl -d=3

&filelist
  base_filename='output/data_constrained'
  restart_from_file='output/data_driven_mfr0000.dat'
  saveprim=.true.
  autoconvert=.true.
  convert_type='vtuBCCmpi'
/
&savelist
  dtsave_dat=10.d0
  ditsave_log=1
/
&stoplist
  time_max=60.d0
/
&methodlist
  time_stepper='threestep'
  flux_scheme=20*'hll'
  limiter=20*'cada3'
  small_pressure=1.d-14
  small_density=1.d-14
/
&boundlist
  typeboundary_min1=7*'cont'
  typeboundary_max1=7*'cont'
  typeboundary_min2=7*'cont'
  typeboundary_max2=7*'cont'
  typeboundary_min3=7*'special'
  typeboundary_max3=7*'cont'
/
&meshlist
  refine_criterion=3
  refine_max_level=1
  refine_threshold=20*0.2d0
  derefine_ratio=20*0.1d0
  w_refine_weight(1)=0.4d0
  w_refine_weight(5)=0.2d0
  w_refine_weight(6)=0.2d0
  w_refine_weight(7)=0.2d0
  block_nx1=12
  block_nx2=12
  block_nx3=12
  domain_nx1=144
  domain_nx2=96
  domain_nx3=96
  xprobmin1=-11.13894d0
  xprobmax1=11.13894d0
  xprobmin2=-7.474815d0
  xprobmax2=7.474815d0
  xprobmin3=0.07786265625d0
  xprobmax3=15.02749265625d0
  prolongprimitive=.false.
  ditregrid=10
/
&paramlist
  typecourant='maxsum'
  courantpar=0.8d0
/
&mhd_list
  mhd_energy=.false.
  mhd_adiab=0.d0
  mhd_gravity=.false.
  mhd_eta=0.d0
  mhd_magnetofriction=.false.
  typedivbfix='linde'
  boundary_divbfix_skip(5)=1
/
&usr_list
  physics_model='zero_beta'
  atmosphere_model='uniform'
  atmosphere_source='hydrostatic'
  rho_reference_height_cm=0.d0
  rho_reference_numberdensity_cm3=1.d9
  bottom_numberdensity_cm3=1.d9
  boundary_series_dir='../MagneticBoundary/Evolution/Sequence'
  driving_time_scale=12.d0
/
