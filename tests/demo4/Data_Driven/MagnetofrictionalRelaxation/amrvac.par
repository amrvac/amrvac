!$AMRVAC_DIR/setup.pl -d=3

&filelist
  base_filename='output/data_driven_mfr'
  restart_from_file='output/data_driven_potential0000.dat'
  saveprim=.true.
  autoconvert=.true.
  convert_type='vtuBCCmpi'
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=0.d0
/

&methodlist
  ! These are consumed directly by the legacy MHD magnetofriction routine.
  time_stepper='onestep'
  flux_scheme=20*'cd4'
/

&boundlist
  typeboundary_min1=7*'cont'
  typeboundary_max1=7*'cont'
  typeboundary_min2=7*'cont'
  typeboundary_max2=7*'cont'
  typeboundary_min3=7*'special'
  typeboundary_max3=7*'cont'
/

&meshlist
  refine_criterion=3
  refine_max_level=1
  refine_threshold=20*0.2d0
  derefine_ratio=20*0.1d0
  w_refine_weight(1)=0.4d0
  w_refine_weight(5)=0.2d0
  w_refine_weight(6)=0.2d0
  w_refine_weight(7)=0.2d0
  block_nx1=12
  block_nx2=12
  block_nx3=12
  domain_nx1=144
  domain_nx2=96
  domain_nx3=96
  xprobmin1=-11.13894d0
  xprobmax1=11.13894d0
  xprobmin2=-7.474815d0
  xprobmax2=7.474815d0
  xprobmin3=0.07786265625d0
  xprobmax3=15.02749265625d0
  prolongprimitive=.false.
  ditregrid=10
/

&mhd_list
  mhd_energy=.false.
  ! Use the legacy magnetofriction implementation embedded in MHD.
  mhd_magnetofriction=.true.
  typedivbfix='linde'
  ! Preserve the observed normal field in the first lower ghost layer.
  boundary_divbfix_skip(5)=1
/

&mf_list
  mf_it_max=100000
  mf_ditsave=20000
  mf_cc=0.5d0
  mf_cy=0.2d0
  mf_cdivb=0.01d0
  ! 'auto' replaces the CSV for a potential-field start (it=0) and appends
  ! when restarting an MF checkpoint (it>0). Set a custom path if desired.
  mf_log_mode='auto'
  mf_log_filename=''
/

&usr_list
  boundary_filename='boundary_single/B_0001.dat'
/
