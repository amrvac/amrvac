! Small AMR TDm prominence snapshot for synthetic-radiation tests.

&filelist
  base_filename='output/radsyn_tdm_prom_amr_'
  saveprim=.true.
  autoconvert=.false.
  convert_type='vtuBCCmpi'
  nwauxio=2
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
  small_pressure=1.d-12
  small_density=1.d-12
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&meshlist
  refine_max_level=2
  refine_criterion=1
  max_blocks=600
  block_nx1=8
  block_nx2=8
  block_nx3=8
  domain_nx1=32
  domain_nx2=24
  domain_nx3=32
  xprobmin1=-10.d0
  xprobmax1= 10.d0
  xprobmin2=-7.5d0
  xprobmax2= 7.5d0
  xprobmin3= 0.d0
  xprobmax3= 10.d0
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&usr_list
  minor_radius_cm=2.25d9
  n_axis_points=400
  atmosphere_curve='AL-C7'
  rho_ref_height_cm=1.0d9
  rho_ref=0.5d0
  prom_density_factor=100.0d0
  dip_bz_max=0.4d0
  prom_axis_fraction=1.0d0
/
