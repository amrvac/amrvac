! Initialize the spherical TDm/RBSL-like demo field on a radially stretched
! AMR mesh. Base grid: 128 x 96 x 128. Max refinement level: 3. Only x1=r is
! stretched; x2=theta and x3=phi remain uniform.
! This writes a snapshot only; it does not run magnetic topology tracing.

&filelist
  base_filename='output/spherical_tdm_amr_l3_rstretch_'
  saveprim=.true.
  autoconvert=.false.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_log=1.d99
  dtsave_dat=1.d99
/

&stoplist
  time_max=0.d0
/

&methodlist
  time_stepper='threestep'
  flux_scheme=20*'hll'
  limiter=20*'cada3'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
  nghostcells=4
/

&meshlist
  refine_max_level=3
  refine_criterion=1
  max_blocks=12000
  block_nx1=32
  block_nx2=32
  block_nx3=32
  domain_nx1=128
  domain_nx2=96
  domain_nx3=128
  xprobmin1=69.61d0
  xprobmax1=79.61d0
  xprobmin2=0.2270568141714314d0
  xprobmax2=0.2729431858285686d0
  xprobmin3=-0.01718120494117723d0
  xprobmax3= 0.01718120494117723d0
  stretch_dim(1)='uni'
  stretch_uncentered=.false.
  qstretch_baselevel(1)=1.02d0
/

&paramlist
  typecourant='maxsum'
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
/

&usr_list
  minor_radius_cm=2.25d9
  n_axis_points=400
  rho0=1.0d0
  pressure0=1.0d0
/

&magnetic_topology_list
  mt_enable=.false.
/
