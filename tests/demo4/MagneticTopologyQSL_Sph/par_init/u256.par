! Initialize the spherical TDm/RBSL-like demo field on a uniform 256 x 192 x 256 mesh.
! This writes a snapshot only; it does not run magnetic topology tracing.

&filelist
  base_filename='output/spherical_tdm_u256_'
  saveprim=.true.
  autoconvert=.false.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
  dtsave_log=1.d99
  dtsave_dat=1.d99
/

&stoplist
  time_max=0.d0
/

&methodlist
  time_stepper='threestep'
  flux_scheme=20*'hll'
  limiter=20*'cada3'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
  nghostcells=4
/

&meshlist
  refine_criterion=3
  refine_max_level=1
  block_nx1=32
  block_nx2=32
  block_nx3=32
  domain_nx1=256
  domain_nx2=192
  domain_nx3=256
  xprobmin1=69.61d0
  xprobmax1=79.61d0
  xprobmin2=0.2270568141714314d0
  xprobmax2=0.2729431858285686d0
  xprobmin3=-0.01718120494117723d0
  xprobmax3= 0.01718120494117723d0
/

&paramlist
  typecourant='maxsum'
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
/

&usr_list
  minor_radius_cm=2.25d9
  n_axis_points=400
  rho0=1.0d0
  pressure0=1.0d0
/

&magnetic_topology_list
/
