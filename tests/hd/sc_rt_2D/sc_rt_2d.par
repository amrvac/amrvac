!setup.pl -d=2
 &filelist
        base_filename = 'sc_rt_2d'
        typefilelog   = 'regression_test'
        autoconvert   = .false.
 /

 &savelist
        ditsave_log = 1
 /

 &stoplist
        it_max = 2
 /

 &methodlist
        time_stepper = 'onestep'
        flux_scheme  = 20*'tvdlf'
        limiter      = 20*'minmod'
 /

 &boundlist
        typeboundary_min1 = 4*'periodic'
        typeboundary_max1 = 4*'periodic'
        typeboundary_min2 = 4*'cont'
        typeboundary_max2 = 4*'cont'
 /

 &meshlist
        refine_max_level = 1
        block_nx1  = 16
        block_nx2  = 16
        domain_nx1 = 128
        domain_nx2 = 64
        xprobmin1  = 0.0d0
        xprobmax1  = 1.0d0
        xprobmin2  = 0.0d0
        xprobmax2  = 0.5d0
 /

 &hd_list
        hd_radiative_transfer = .true.
 /

 &paramlist
        courantpar = 0.8d0
 /

 &rt_list
        rt_sc_updim     = 2
        rt_sc_amr_level = 1
        rt_sc_bc_min    = 'thermal'
        rt_sc_bc_max    = 'open'
        rt_sc_quad      = 'GL'
        rt_sc_nmu       = 4
        rt_sc_ndir      = 4
        ! The heating is computed but not applied, so that the cases test the transport alone
        rt_sc_cfl       = 0.0d0
 /
