 &filelist
        base_filename = '_table_pipe'
 /

 &usr_list
        rt_case = 'table'
 /

 &eos_list
        eos_type = 'LTE'
        ionE     = .true.
        table_location = '../../../src/tables/eos_tables/entropy128/'
 /

 &meshlist
        xprobmax1  = 2.0d0
        xprobmax2  = 1.0d0
 /

 &rt_list
        rt_sc_distributed = .true.
        rt_sc_pipeline    = .true.
        rt_sc_quad        = 'Carlson'
        rt_sc_opacity     = 'Rosseland'
        rt_sc_kappa_table = 'rosseland_combined.tab'
 /
