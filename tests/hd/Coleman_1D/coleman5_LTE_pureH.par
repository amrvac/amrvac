!setup.pl -d=1
!> Coleman (5) -- LTE_pureH
!> Symmetric outflow (double rarefaction)

&filelist
  base_filename = 'coleman5_LTE_pureH'
  saveprim      = .true.
  convert_type  = 'vtuBCCmpi'
  autoconvert   = .true.
  typefilelog   = 'regression_test'
/

&savelist
  itsave(1,1)  = 0
  itsave(1,2)  = 0
  dtsave_log   = 0.01d0
  dtsave_dat   = 0.62933d0
/

&stoplist
  time_max = 0.62933d0
/

&methodlist
  time_stepper    = 'threestep'
  flux_scheme     = 20*'hllc'
  limiter         = 20*'ppm'
  typeboundspeed  = 'pvrs'
/

&boundlist
  typeboundary_min1 = 3*'cont'
  typeboundary_max1 = 3*'cont'
/

&meshlist
  refine_max_level  = 1
  block_nx1         = 64
  domain_nx1        = 1024
  xprobmin1         = 0.0d0
  xprobmax1         = 1.0d0
/

&paramlist
  typecourant = 'maxsum'
  courantpar  = 0.4d0
/

&hd_list
  hd_energy          = .true.
  hd_gravity         = .false.
/

&eos_list
  eos_type      = 'LTE'
  ionE          = .true.
  eos_method    = 'entropy'
  table_location = '../../../src/tables/eos_tables/entropy128/'
  He_abundance  = 0.0d0
/

&usr_list
  rho_L = 1.2109531e+04
  rho_R = 1.2109531e+04
  v_L   = -3.1779648e-01
  v_R   = 3.1779648e-01
  T_L   = 1.4991387e-02
  T_R   = 1.4991387e-02
/
