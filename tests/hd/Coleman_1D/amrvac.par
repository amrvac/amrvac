!setup.pl -d=1
!> Coleman (1) -- FI_HHe
!> Sod-like shock through H ionisation onset

&filelist
  base_filename = 'output/coleman1_FI_HHe_'
  saveprim      = .true.
  convert_type  = 'vtuBCCmpi'
  autoconvert   = .true.
  typefilelog   = 'regression_test'
/

&savelist
  itsave(1,1)  = 0
  itsave(1,2)  = 0
  dtsave_log   = 0.01d0
  dtsave_dat   = 0.62933d0
/

&stoplist
  time_max = 0.62933d0
/

&methodlist
  time_stepper    = 'threestep'
  flux_scheme     = 20*'hllc'
  limiter         = 20*'ppm'
  typeboundspeed  = 'pvrs'
/

&boundlist
  typeboundary_min1 = 3*'cont'
  typeboundary_max1 = 3*'cont'
/

&meshlist
  refine_max_level  = 1
  block_nx1         = 64
  domain_nx1        = 1024
  xprobmin1         = 0.0d0
  xprobmax1         = 1.0d0
/

&paramlist
  typecourant = 'maxsum'
  courantpar  = 0.4d0
/

&hd_list
  hd_energy          = .true.
  hd_gravity         = .false.
/

&eos_list
  eos_type      = 'FI'
  gamma         = 1.6666666666666667d0
  He_abundance  = 0.1d0
/

&usr_list
  rho_L = 1.5136914e+01
  rho_R = 1.8921142e+00
  v_L   = 0.0000000e+00
  v_R   = 0.0000000e+00
  T_L   = 2.3670611e-02
  T_R   = 9.7838523e-03
/
