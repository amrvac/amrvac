!setup.pl -d=1
!> Coleman (2) -- FI_pureH
!> Strong shock through H ionisation zone

&filelist
  base_filename = 'coleman2_FI_pureH'
  saveprim      = .true.
  convert_type  = 'vtuBCCmpi'
  autoconvert   = .true.
  typefilelog   = 'regression_test'
/

&savelist
  itsave(1,1)  = 0
  itsave(1,2)  = 0
  dtsave_log   = 0.01d0
  dtsave_dat   = 0.75520d0
/

&stoplist
  time_max = 0.75520d0
/

&methodlist
  time_stepper    = 'threestep'
  flux_scheme     = 20*'hllc'
  limiter         = 20*'ppm'
  typeboundspeed  = 'pvrs'
/

&boundlist
  typeboundary_min1 = 3*'cont'
  typeboundary_max1 = 3*'cont'
/

&meshlist
  refine_max_level  = 1
  block_nx1         = 64
  domain_nx1        = 1024
  xprobmin1         = 0.0d0
  xprobmax1         = 1.0d0
/

&paramlist
  typecourant = 'maxsum'
  courantpar  = 0.4d0
/

&hd_list
  hd_energy          = .true.
  hd_gravity         = .false.
/

&eos_list
  eos_type      = 'FI'
  gamma         = 1.6666666666666667d0
  He_abundance  = 0.0d0
/

&usr_list
  rho_L = 6.0547655e+02
  rho_R = 6.0547655e+00
  v_L   = 0.0000000e+00
  v_R   = 0.0000000e+00
  T_L   = 1.8936488e-02
  T_R   = 2.9982773e-03
/
