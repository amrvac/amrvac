
 &filelist
        base_filename = 'TIautotest_wc'
        typefilelog='regression_test'
 /

 &savelist
        dtsave_log  = 0.05d0
        dtsave_dat  = 0.5d0
 /

 &stoplist
        dtmin    = 1.d-6
        time_max = 3.0d0
 /

 &methodlist
        time_stepper  = 'fourstep'
        flux_scheme   = 20*'tvdlf'
        limiter       = 20*'cada3'
 /

 &boundlist
        typeboundary_min1 = 3*'periodic'
        typeboundary_max1 = 3*'periodic'
 /

 &meshlist
        refine_criterion = 3
        refine_max_level = 3 
        block_nx1        = 16
        domain_nx1       = 400
        xprobmin1        = 0.d0
        xprobmax1        = 10.d0
 /

 &paramlist
        typecourant = 'maxsum'
        courantpar  = 0.8d0
 /

 &hd_list
        hd_radiative_cooling  = .true.
        hd_thermal_conduction = .true. 
 /

 &rc_list
        ncool      = 4000
        coolcurve  = 'Hildner'
        Tfix=.true.
        tlow=1.0d-3 ! lowest T in Hildner table
 /

&tc_list
       tc_saturate=.true.
/

&sts_list
       sts_dtpar=0.4d0
/

 &usr_list
        rho0=10.0d0
        p0=20.0d0
        A0=1.0d-1
 /

 &eos_list
  gamma = 1.6666667d0 
  He_abundance = 0.0d0
 /
