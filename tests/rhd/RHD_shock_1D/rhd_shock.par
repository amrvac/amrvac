&testlist
        teststr=''
/

&filelist
  base_filename='rhd_shock'
  autoconvert      = F
  typefilelog='regression_test'
/

 &savelist
   itsave(1,1)=0
   itsave(1,2)=0
   dtsave_log     = 0.01d0
   dtsave_dat     = 0.1d0
/

   time_max = 1.0d0
 &stoplist
   time_max = 0.1d0
   dtmin = 1.0d-20
/

 &methodlist
   time_stepper    = 'threestep'
   time_integrator = 'IMEX_232'
   flux_scheme     = 20*'hll'
   limiter         = 20*'cada3'
/

&boundlist
  typeboundary_min1 = 4*'special'
  typeboundary_max1 = 4*'cont' 
/

 &meshlist
   refine_max_level   = 1
   domain_nx1         = 256
   block_nx1          = 16
   xprobmin1       = -0.5d0
   xprobmax1       = 0.5d0
 /

 &paramlist
  courantpar= 0.4d0
  slowsteps = 1000
 /

 &hd_list
  hd_gravity = .false.
  hd_energy = .true.
  hd_radiation_fld = .true.
 /

 &fld_list
  fld_Radforce_split = .false.
  fld_opacity_law = 'const'
  fld_kappa0 = 0.4d0
  fld_interaction_method = 'Halley'
  fld_fluxlimiter = 'Diffusion'
  fld_diff_tol = 1.d-6
  fld_bisect_tol=1.d-6
  /

  &shock_list
   rho1 = 1.d-2
   rho2 = 0.0685847d0
   v1 = 1.d9
   T1 = 1.d4
   /
 &eos_list
  gamma = 1.4d0
  He_abundance = 0.0d0
 /

